---
import { Utensils } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  message?: string;
  description?: string;
}

const { message = "Nie znaleziono strony", description = "Adres mógł się zmienić albo ta pozycja została usunięta." } =
  Astro.props;
---

<section class="mx-auto flex max-w-md flex-col items-center gap-4 py-12 text-center sm:py-20">
  <div aria-hidden="true" class="bg-secondary text-muted-foreground mb-2 grid size-32 place-items-center rounded-full">
    <Utensils className="size-12" />
  </div>
  <h1 class="text-foreground text-3xl font-extrabold">{message}</h1>
  <p class="text-muted-foreground">{description}</p>
  <a href="/" class:list={[buttonVariants({ size: "lg" }), "mt-2"]}>
    Wróć do listy przepisów
  </a>
</section>
