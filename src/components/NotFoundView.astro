---
import { Utensils } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  message?: string;
  description?: string;
}

const { message = "Nie znaleziono strony", description = "Adres mógł się zmienić albo ta pozycja została usunięta." } =
  Astro.props;
---

<section class="mx-auto flex max-w-md flex-col items-center gap-4 pt-24 pb-16 text-center sm:pt-32">
  <div
    aria-hidden="true"
    class="bg-secondary text-muted-foreground/60 mb-2 grid size-40 place-items-center rounded-full"
  >
    <Utensils className="size-20" />
  </div>
  <h1 class="text-foreground text-2xl font-extrabold sm:text-3xl">{message}</h1>
  <p class="text-muted-foreground">{description}</p>
  <a href="/" class:list={[buttonVariants({ size: "lg" }), "mt-2 font-bold"]}>
    Wróć do listy przepisów
  </a>
</section>
