---
import ThemeToggle from "@/components/ThemeToggle";
import { buttonVariants } from "@/components/ui/button";

const { user } = Astro.locals;
---

<header class="border-border bg-card/50 border-b backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="from-brand-from to-brand-to bg-gradient-to-r bg-clip-text text-xl font-bold text-transparent">
      PasujeMi
    </a>
    <div class="flex min-w-0 items-center gap-3 text-sm">
      <span class="text-muted-foreground truncate">{user?.email}</span>
      <ThemeToggle client:load />
      <form method="POST" action="/api/auth/signout" class="shrink-0">
        <button type="submit" class:list={[buttonVariants({ variant: "outline", size: "sm" })]}>
          Wyloguj
        </button>
      </form>
    </div>
  </div>
</header>
