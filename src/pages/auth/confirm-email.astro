---
import { Check, Mail } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import ThemeLink from "@/components/ThemeLink";
import { buttonVariants } from "@/components/ui/button";

// With e-mail confirmation off, signup signs the user in at once, so a session means the account is ready.
// In development `?variant=mail` previews the "check your mail" screen.
const previewMail = import.meta.env.DEV && Astro.url.searchParams.get("variant") === "mail";
const isAutoConfirmed = Boolean(Astro.locals.user) && !previewMail;

const content = isAutoConfirmed
  ? {
      heading: "Konto założone",
      description: "Twoje konto jest gotowe.",
      linkHref: "/",
      linkText: "Przejdź do aplikacji",
    }
  : {
      heading: "Sprawdź skrzynkę e-mail",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkHref: "/auth/signin",
      linkText: "Wróć do logowania",
    };
const Icon = isAutoConfirmed ? Check : Mail;
// "e-mail" never breaks at its hyphen.
const descriptionParts = content.description.split("e-mail");
---

<Layout title={`${content.heading} · PasujeMi`}>
  <div class="bg-background flex min-h-screen flex-col px-4 py-6">
    <Logo large />
    <main class="mx-auto flex w-full max-w-sm flex-1 flex-col items-center justify-center text-center">
      <div class="bg-hero text-hero-foreground mb-6 grid size-24 place-items-center rounded-full">
        <Icon className="size-10" aria-hidden="true" />
      </div>
      <h1 class="mb-3 text-2xl font-extrabold sm:text-3xl">{content.heading}</h1>
      <p class="text-muted-foreground mb-8">
        {descriptionParts.map((part, i) => (
          <>
            {i > 0 && <span class="whitespace-nowrap">e-mail</span>}
            {part}
          </>
        ))}
      </p>
      <a href={content.linkHref} class:list={[buttonVariants({ variant: "secondary", size: "lg" }), "font-bold"]}>
        {content.linkText}
      </a>
    </main>
    <div class="text-center">
      <ThemeLink client:load />
    </div>
  </div>
</Layout>
