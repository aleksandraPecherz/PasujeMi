---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authErrorMessage, emailFromQuery } from "@/lib/auth-errors";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
// The e-mail is kept only after a failed attempt; a bare ?email= does not prefill the form.
const email = error ? emailFromQuery(Astro.url.searchParams.get("email")) : "";
---

<Layout title="Zaloguj się · PasujeMi">
  <AuthShell>
    <h1 class="text-3xl font-extrabold">Zaloguj się</h1>
    <p class="text-muted-foreground mt-2 mb-6">Twoja spiżarka i przepisy czekają.</p>
    <SignInForm serverError={error} initialEmail={email} autoFocusPassword={Boolean(email)} client:load />
    <p class="text-muted-foreground mt-6 text-center">
      Nie masz konta?{" "}
      <a href="/auth/signup" class="text-primary font-bold underline hover:no-underline">
        Załóż konto
      </a>
    </p>
  </AuthShell>
</Layout>
