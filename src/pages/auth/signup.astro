---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { authErrorMessage, emailFromQuery } from "@/lib/auth-errors";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
// The e-mail is kept only after a failed attempt; a bare ?email= does not prefill the form.
const email = error ? emailFromQuery(Astro.url.searchParams.get("email")) : "";
---

<Layout title="Załóż konto · PasujeMi">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Załóż konto
      </h1>
      <SignUpForm serverError={error} initialEmail={email} autoFocusPassword={Boolean(email)} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-purple-300 hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
