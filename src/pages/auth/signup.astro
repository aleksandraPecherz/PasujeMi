---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { authErrorMessage, emailFromQuery } from "@/lib/auth-errors";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
// The e-mail is kept only after a failed attempt; a bare ?email= does not prefill the form.
const email = error ? emailFromQuery(Astro.url.searchParams.get("email")) : "";
---

<Layout title="Załóż konto · PasujeMi">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-brand-from to-brand-to bg-clip-text text-center text-2xl font-bold text-transparent">
        Załóż konto
      </h1>
      <SignUpForm serverError={error} initialEmail={email} autoFocusPassword={Boolean(email)} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-primary hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
