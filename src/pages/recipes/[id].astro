---
import NotFoundView from "@/components/NotFoundView.astro";
import { RecipeDetails } from "@/components/recipes/RecipeDetails";
import RecipeAuthorActions from "@/components/recipes/RecipeAuthorActions";
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { isAdmin } from "@/lib/services/admins";
import { getRecipe } from "@/lib/services/recipes";
import type { Recipe } from "@/types";

let recipe: Recipe | null = null;
let canManage = false;
let failure: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  Astro.response.status = 503;
  failure = "Serwis jest chwilowo niedostępny. Spróbuj ponownie za chwilę.";
} else {
  try {
    const found = await getRecipe(supabase, Astro.params.id ?? "");
    recipe = found?.recipe ?? null;
    const userId = Astro.locals.user?.id;
    // UX only: the Edit/Delete buttons for the author or an admin. The boundary is RLS (the API returns 404 to anyone else).
    if (found && userId) {
      canManage = found.authorId === userId;
      if (!canManage) {
        // The buttons are not worth a 500: when the lookup fails the page stays readable, without them.
        try {
          canManage = await isAdmin(supabase, userId);
        } catch (error) {
          // eslint-disable-next-line no-console -- server-side log, visible in Workers logs
          console.error("isAdmin failed", error);
        }
      }
    }
  } catch (error) {
    // eslint-disable-next-line no-console -- server-side log, visible in Workers logs
    console.error("getRecipe failed", error);
    Astro.response.status = 500;
    failure = "Nie udało się wczytać przepisu. Spróbuj ponownie za chwilę.";
  }
}

if (!failure && !recipe) {
  Astro.response.status = 404;
}
---

<AppLayout title={recipe?.name ?? (failure ? "Błąd" : "Nie znaleziono przepisu")}>
  {recipe ? (
    <RecipeDetails recipe={recipe}>
      <Fragment slot="actions">
        {canManage && <RecipeAuthorActions client:load recipeId={recipe.id} recipeName={recipe.name} />}
      </Fragment>
    </RecipeDetails>
  ) : failure ? (
    <NotFoundView message="Coś poszło nie tak" description={failure} />
  ) : (
    <NotFoundView message="Nie znaleziono przepisu" />
  )}
</AppLayout>
