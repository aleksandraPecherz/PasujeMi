---
if (!import.meta.env.DEV) return new Response(null, { status: 404 });
/* eslint @typescript-eslint/no-misused-promises: "off" -- the rule crashes on a top-level return in frontmatter */

import AppLayout from "@/layouts/AppLayout.astro";
import Banner from "@/components/Banner.astro";
import NotFoundView from "@/components/NotFoundView.astro";
import KitchenSink from "@/components/dev/KitchenSink";
---

<AppLayout title="Kitchen sink — PasujeMi">
  <div class="flex flex-col gap-6">
    <section class="border-border bg-card flex flex-col gap-4 rounded-2xl border p-4 sm:p-6">
      <div>
        <h2 class="text-lg font-semibold">Banner</h2>
        <p class="text-muted-foreground text-sm">
          Komunikat o brakującej konfiguracji (wariant error, role="alert"); link w treści jest podkreślony i
          pogrubiony.
        </p>
      </div>
      <Banner variant="error">
        <strong>Uwaga:</strong> Brak konfiguracji Supabase.{" "}
        <a href="https://supabase.com/docs" target="_blank" rel="noopener noreferrer">
          Dokumentacja
        </a>
        .
      </Banner>
    </section>
    <section class="bg-card flex flex-col gap-4 rounded-2xl p-4 sm:p-6">
      <div>
        <h2 class="text-lg font-semibold">Widok „nie znaleziono”</h2>
        <p class="text-muted-foreground text-sm">
          Trzy stany tego samego widoku: ogólny 404, brak przepisu i błąd wczytywania (teksty jak na stronach).
        </p>
      </div>
      <NotFoundView />
      <NotFoundView message="Nie znaleziono przepisu" />
      <NotFoundView
        message="Coś poszło nie tak"
        description="Nie udało się wczytać przepisu. Spróbuj ponownie za chwilę."
      />
    </section>
    <KitchenSink client:load />
  </div>
</AppLayout>
