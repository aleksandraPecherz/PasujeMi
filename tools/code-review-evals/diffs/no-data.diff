--- /dev/null
+++ b/src/lib/demo/format-quantity.ts
@@ -0,0 +1,8 @@
+export type Unit = "g" | "kg" | "ml" | "l" | "pcs";
+
+// Shows grams as kilograms and millilitres as litres from 1000 up; every other value is left as it is.
+export function formatQuantity(quantity: number, unit: Unit): string {
+  if (unit === "g" && quantity >= 1000) return `${quantity / 1000} kg`;
+  if (unit === "ml" && quantity >= 1000) return `${quantity / 1000} l`;
+  return `${quantity} ${unit}`;
+}
