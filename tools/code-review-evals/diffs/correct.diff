+import { describe, expect, it } from "vitest";
+import { mergeQuantities } from "@/lib/demo/merge-quantities";
+
+describe("mergeQuantities", () => {
+  it("sums quantities of items with the same name, ignoring case and surrounding spaces", () => {
+    const result = mergeQuantities([
+      { name: "Milk", quantity: 1 },
+      { name: " milk ", quantity: 2 },
+      { name: "Eggs", quantity: 6 },
+    ]);
+    expect(result).toEqual([
+      { name: "Milk", quantity: 3 },
+      { name: "Eggs", quantity: 6 },
+    ]);
+  });
+
+  it("returns an empty list for no items", () => {
+    expect(mergeQuantities([])).toEqual([]);
+  });
+
+  it("does not modify the input", () => {
+    const input = [
+      { name: "Milk", quantity: 1 },
+      { name: "milk", quantity: 2 },
+    ];
+    mergeQuantities(input);
+    expect(input).toEqual([
+      { name: "Milk", quantity: 1 },
+      { name: "milk", quantity: 2 },
+    ]);
+  });
+
+  it("throws a RangeError for a negative or non-finite quantity", () => {
+    expect(() => mergeQuantities([{ name: "Milk", quantity: -1 }])).toThrow(RangeError);
+    expect(() => mergeQuantities([{ name: "Milk", quantity: Number.NaN }])).toThrow(RangeError);
+  });
+});
