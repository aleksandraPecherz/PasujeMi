@@ -0,0 +1,17 @@
+export type ListItem = { name: string; quantity: number };
+
+// Sums the quantities of items that share a name (trimmed, case-insensitive).
+// Keeps the first spelling and the first-seen order; the input is not modified.
+export function mergeQuantities(items: readonly ListItem[]): ListItem[] {
+  const merged = new Map<string, ListItem>();
+  for (const item of items) {
+    if (!Number.isFinite(item.quantity) || item.quantity < 0) {
+      throw new RangeError(`Invalid quantity for "${item.name}": ${item.quantity}`);
+    }
+    const key = item.name.trim().toLowerCase();
+    const existing = merged.get(key);
+    if (existing) existing.quantity += item.quantity;
+    else merged.set(key, { name: item.name.trim(), quantity: item.quantity });
+  }
+  return [...merged.values()];
+}
