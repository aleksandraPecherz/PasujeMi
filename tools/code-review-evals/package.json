{
  "name": "code-review-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "promptfoo evals for the code-reviewer agent (runs the real runReview(), no model-graded assertions)",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx src/preflight.ts",
    "fingerprint": "tsx src/fingerprint.ts",
    "promptfoo": "tsx src/cli.ts",
    "check:loader": "tsx --test \"checks/**/*.test.ts\"",
    "eval": "tsx src/cli.ts eval -c promptfooconfig.yaml --no-cache --max-concurrency 1 --repeat 1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "promptfoo": "0.125.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
