+// Fictional example, not part of the real project.
+export function buildGreeting(name: string, items: string[]): string {
+  const first = items[0].toUpperCase();
+  return `Hello ${name}, your first item is ${first}`;
+}
+
+export function findUser(db: { query(sql: string): unknown[] }, id: string) {
+  return db.query("SELECT * FROM users WHERE id = '" + id + "'")[0];
+}
